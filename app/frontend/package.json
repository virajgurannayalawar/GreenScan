{
  "name": "pestiscan",
  "version": "0.1.0",
  "private": true,
  "description": "PestiScan — multispectral TIFF preview with an apple dataset classifier.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "android": "react-native run-android",
